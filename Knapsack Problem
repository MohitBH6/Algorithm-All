#include <iostream>
#include <vector>
using namespace std;
void bubbleSort(float arr[2][4], int n) {
    bool swapped;
    for (int i = 0; i < n - 1; i++) {
        swapped = false;
        for (int j = 0; j < n - i - 1; j++) {  // Fixed the loop condition here
            if (arr[0][j] < arr[0][j + 1]) {
                swap(arr[0][j], arr[0][j + 1]);
                swap(arr[1][j], arr[1][j + 1]);
                swapped = true;
            }
        }
        if (!swapped)
            break;
    }
}

