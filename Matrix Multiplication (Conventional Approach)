#include <iostream>
using namespace std;

void multiplyMatrices(int first[][3], int second[][3], int result[][3], int rowFirst, int colFirst, int colSecond) {
    for (int i = 0; i < rowFirst; i++) {
        for (int j = 0; j < colSecond; j++) {
            result[i][j] = 0;
            for (int k = 0; k < colFirst; k++) {
                result[i][j] += first[i][k] * second[k][j];
            }
        }
    }
}

int main() {
    int first[2][3] = {{1, 2, 3}, {4, 5, 6}};
    int second[3][2] = {{7, 8}, {9, 10}, {11, 12}};
    int result[2][2];

    multiplyMatrices(first, second, result, 2, 3, 2);

    cout << "Resultant Matrix:\n";
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            cout << result[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
