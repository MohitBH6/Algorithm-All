#include <iostream>
#include <vector>
using namespace std;

void generateTriangles(vector<int>& arr, int n) {
    for (int i = 0; i < n - 2; i++) {
        for (int j = i + 1; j < n - 1; j++) {
            for (int k = j + 1; k < n; k++) {
                cout << "(" << arr[i] << ", " << arr[j] << ", " << arr[k] << ")\n";
            }
        }
    }
}

int main() {
    vector<int> arr = {1, 2, 3, 4, 5};
    generateTriangles(arr, arr.size());

    return 0;
}
